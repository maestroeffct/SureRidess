# API_URL=https://sureride-backend-production.up.railway.app
API_URL=http://10.0.2.2:4000
DEV_BYPASS_KYC=false

STRIPE_MERCHANT_ID=merchant.com.sureride
STRIPE_URL_SCHEME=sureride

# RestCountries v5 API key — used for the country picker.
# Sign up at https://restcountries.com or use rc_live_demo for testing.
# Leave blank to skip the API call and use the bundled fallback list directly.
RESTCOUNTRIES_API_KEY=

# Google Sign-In — the "Web" OAuth 2.0 client ID from Google Cloud Console.
# Required on both iOS and Android because @react-native-google-signin uses
# it to mint an ID token whose `aud` matches what the backend verifies
# against (GOOGLE_CLIENT_ID on the server). Leave blank to disable the
# Google button; the app still boots.
#
# iOS extra step: add REVERSED_CLIENT_ID from GoogleService-Info.plist to
# Info.plist CFBundleURLTypes.
# Android extra step: nothing — the SHA-1 you registered in Google Cloud
# Console must match the keystore that signs the build.
GOOGLE_WEB_CLIENT_ID=
