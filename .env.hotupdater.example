# Copy to .env.hotupdater (gitignored) and fill in before running
# `npx hot-updater deploy` or `npx hot-updater console`.
#
# HOT_UPDATER_AUTH_TOKEN must be the EXACT same value as
# sureride-backend's HOT_UPDATER_AUTH_TOKEN env var — it's a shared
# secret between the two repos, not generated separately here.
HOT_UPDATER_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible) bucket that stores the JS bundle files.
# Must be the SAME bucket/credentials the backend's R2_* vars point at
# (sureride-backend/src/modules/ota/hotUpdater.ts) — the CLI uploads here
# directly; the server only stores the resulting URL.
R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional — defaults to the production backend's /hot-updater path.
# Override only when publishing against a different environment.
# HOT_UPDATER_SERVER_URL=https://sureride-backend.onrender.com/hot-updater
